{
  "realm": "logintegrite",
  "enabled": true,
  "displayName": "Log Integrite",
  "loginTheme": "asce-lc",
  "accountTheme": "asce-lc",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr"],
  "defaultLocale": "fr",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "defaultRole": {
    "name": "default-roles-logintegrite",
    "composite": true,
    "composites": { "realm": ["CONSULTANT", "offline_access", "uma_authorization"] }
  },
  "roles": {
    "realm": [
      { "name": "CONSULTANT", "description": "Consultation" },
      { "name": "AGENT", "description": "Agent saisie" },
      { "name": "VALIDATEUR", "description": "Validateur des fiches" },
      { "name": "ADMIN", "description": "Administrateur" }
    ]
  },
  "clients": [
    {
      "clientId": "logintegrite-backend",
      "name": "Log Integrite (frontend Angular)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "audience-logintegrite-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "logintegrite-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "logintegrite-admin-api",
      "name": "Log Integrite (API admin backend)",
      "enabled": true,
      "publicClient": false,
      "secret": "${KC_ADMIN_API_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-logintegrite-admin-api",
      "enabled": true,
      "serviceAccountClientId": "logintegrite-admin-api",
      "clientRoles": { "realm-management": ["view-users", "query-users", "manage-users", "view-realm"] }
    },
    {
      "username": "admin.test", "email": "admin.test@asce-lc.bf", "firstName": "Admin", "lastName": "Test",
      "enabled": true, "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${KC_TEST_USERS_PASSWORD}", "temporary": false }],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "validateur.test", "email": "validateur.test@asce-lc.bf", "firstName": "Validateur", "lastName": "Test",
      "enabled": true, "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${KC_TEST_USERS_PASSWORD}", "temporary": false }],
      "realmRoles": ["VALIDATEUR"]
    },
    {
      "username": "agent.test", "email": "agent.test@asce-lc.bf", "firstName": "Agent", "lastName": "Test",
      "enabled": true, "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${KC_TEST_USERS_PASSWORD}", "temporary": false }],
      "realmRoles": ["AGENT"]
    },
    {
      "username": "consultant.test", "email": "consultant.test@asce-lc.bf", "firstName": "Consultant", "lastName": "Test",
      "enabled": true, "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${KC_TEST_USERS_PASSWORD}", "temporary": false }],
      "realmRoles": ["CONSULTANT"]
    }
  ]
}

# Copier en .env puis remplacer chaque valeur. Ne jamais versionner .env.
# Generer un secret : openssl rand -base64 32

# Mot de passe du role Postgres logintegrite_user (base metier et base Keycloak)
DB_PASSWORD=change-me

# Compte administrateur de la console Keycloak (http://localhost:8180)
KC_ADMIN_PASSWORD=change-me

# Secret du client confidentiel logintegrite-admin-api (le meme est injecte dans le realm et le backend)
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# Mot de passe des comptes de TEST importes dans le realm (admin.test, validateur.test, agent.test).
# Developpement uniquement : retirer le bloc "users" du realm en production.
KC_TEST_USERS_PASSWORD=change-me

# Mot de passe pgAdmin (http://localhost:5050)
PGADMIN_PASSWORD=change-me

# PRODUCTION : copier en .env.prod puis remplacer TOUTES les valeurs. Ne jamais versionner .env.prod.
# Generer un secret : openssl rand -hex 24      (hexadecimal : sans caractere special, sur pour SQL et YAML)

# Nom de domaine UNIQUE (un enregistrement DNS A vers ce serveur). Chemins : / application, /api API, /auth Keycloak.
DOMAIN=logintegrite.asce-lc.bf

# TLS : une adresse e-mail => certificats Let's Encrypt automatiques (ports 80 et 443 ouverts).
# "internal" => autorite locale de Caddy (tests uniquement, certificat non reconnu par les navigateurs).
TLS_MODE=admin@asce-lc.bf

# Reseaux autorises pour la console Keycloak (/admin, realm master). "private_ranges" ou une liste de CIDR.
ADMIN_ALLOW=private_ranges

# Postgres : un role par usage (voir docker/postgres/init-prod.sh)
PG_ADMIN_PASSWORD=change-me
DB_OWNER_PASSWORD=change-me
DB_APP_PASSWORD=change-me
DB_BACKUP_PASSWORD=change-me
KC_DB_PASSWORD=change-me

# Keycloak
KC_ADMIN_PASSWORD=change-me
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# Sauvegardes : intervalle (secondes) et duree de conservation (jours)
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# Chemin du depot frontend (contexte de build)
FRONTEND_CONTEXT=../logintegrite_frontend

# Ports publics : 80 est indispensable a Let's Encrypt. A ne changer qu'en test local.
#HTTP_PORT=80
#HTTPS_PORT=443

# Copie hors serveur chiffree (voir DEPLOIEMENT.md, section 5) : laisser vide tant que non configure
#SAUVEGARDE_DEST=utilisateur@destination:/srv/sauvegardes/logintegrite/
#SAUVEGARDE_PASSPHRASE=/home/administrator/sauvegarde.phrase
#SAUVEGARDE_SSH_OPTIONS=-i /home/administrator/.ssh/id_sauvegarde
#SAUVEGARDE_CONSERVER=14

# Messagerie (mot de passe oublie) : appliquee au realm par scripts/keycloak-smtp.sh
# Boite DEDIEE a Log Integrite ; ne pas reutiliser le compte d'une autre application.
SMTP_HOST=mailer.gov.bf
SMTP_PORT=587
SMTP_USER=logintegrite@asce-lc.bf
SMTP_FROM=logintegrite@asce-lc.bf
SMTP_PASSWORD=change-me
